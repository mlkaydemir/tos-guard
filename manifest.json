{
  "manifest_version": 3,
  "name": "ToS-Guard | Hüküm ve Koşullar Risk Analizcisi",
  "version": "1.0.0",
  "description": "Kullanım koşullarını ve gizlilik politikalarını yakalayıp alıntı doğrulamalı ve prompt injection korumalı yapılandırılmış risk raporu sunar.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ToS-Guard Risk Raporu",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/page_extractor.js",
        "src/content.js"
      ],
      "css": [
        "src/styles/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
